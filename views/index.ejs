<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Irena Website' %></title>
  <!-- Coolvetica Web Font -->
  <link href="https://fonts.cdnfonts.com/css/coolvetica-2" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #ffffff;
      background-image: url('/images/star-tile.png');
      background-repeat: repeat;
      /* Fixed mini star tile */
      background-size: 65px 70px;
      background-position: top left;
      min-height: 100vh;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 190px;
      /* Ultra-smooth multi-stop eased distribution */
      background: linear-gradient(
        to bottom,
        #96D7FF 0%,
        #96D7FF 20%,
        rgba(150, 215, 255, 0.99) 25%,
        rgba(150, 215, 255, 0.97) 30%,
        rgba(150, 215, 255, 0.94) 35%,
        rgba(150, 215, 255, 0.89) 41%,
        rgba(150, 215, 255, 0.82) 47%,
        rgba(150, 215, 255, 0.73) 54%,
        rgba(150, 215, 255, 0.63) 61%,
        rgba(150, 215, 255, 0.52) 68%,
        rgba(150, 215, 255, 0.40) 75%,
        rgba(150, 215, 255, 0.29) 82%,
        rgba(150, 215, 255, 0.18) 88%,
        rgba(150, 215, 255, 0.10) 93%,
        rgba(150, 215, 255, 0.03) 97%,
        rgba(150, 215, 255, 0) 100%
      );
      z-index: 1000;
      padding: 22px 48px 0 36px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 18px;
      text-decoration: none;
      pointer-events: auto;
    }

    .corner-logo {
      height: 75px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .nav-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 34px;
      font-weight: 400;
      color: #ffffff;
      line-height: 1;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 32px;
      margin-left: auto;
      padding-top: 22px;
      pointer-events: auto;
    }

    .nav-item {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 26px;
      font-weight: 400;
      color: #ffffff;
      text-decoration: none;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover {
      opacity: 0.82;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">
        <img src="/images/corner-logo.png" alt="Logo" class="corner-logo">
      </a>
      <span class="nav-title">X ICP RPL 35’</span>
    </div>

    <ul class="nav-menu">
      <li><a href="/" class="nav-item">Home</a></li>
      <li><a href="#kita" class="nav-item">Kita!</a></li>
      <li><a href="#struktur" class="nav-item">Struktur</a></li>
      <li><a href="#kontak" class="nav-item">Kontak</a></li>
    </ul>
  </nav>
</body>
</html>
