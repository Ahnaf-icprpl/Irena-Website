<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Irena Website' %></title>
  <!-- Coolvetica Web Font -->
  <link href="https://fonts.cdnfonts.com/css/coolvetica-2" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #ffffff;
      min-height: 100vh;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 162px;
      /* Eased multi-stop gradient with a smooth fade */
      background: linear-gradient(
        to bottom,
        rgba(150, 215, 255, 1) 0%,
        rgba(150, 215, 255, 0.98) 25%,
        rgba(150, 215, 255, 0.88) 45%,
        rgba(150, 215, 255, 0.70) 62%,
        rgba(150, 215, 255, 0.45) 78%,
        rgba(150, 215, 255, 0.20) 90%,
        rgba(150, 215, 255, 0.05) 96%,
        rgba(150, 215, 255, 0) 100%
      );
      z-index: 1000;
      padding: 16px 48px 0 36px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 18px;
      text-decoration: none;
      pointer-events: auto;
    }

    .corner-logo {
      height: 75px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .nav-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 40.25px;
      font-weight: 400;
      color: #ffffff;
      line-height: 1;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 36px;
      margin-left: auto;
      padding-top: 18px;
      pointer-events: auto;
    }

    .nav-item {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 33.27px;
      font-weight: 400;
      color: #ffffff;
      text-decoration: none;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover {
      opacity: 0.82;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">
        <img src="/images/corner-logo.png" alt="Logo" class="corner-logo">
      </a>
      <span class="nav-title">X ICP RPL 35’</span>
    </div>

    <ul class="nav-menu">
      <li><a href="/" class="nav-item">Home</a></li>
      <li><a href="#kita" class="nav-item">Kita!</a></li>
      <li><a href="#struktur" class="nav-item">Struktur</a></li>
      <li><a href="#kontak" class="nav-item">Kontak</a></li>
    </ul>
  </nav>
</body>
</html>
