<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Irena Website' %></title>
  <!-- Coolvetica Web Font -->
  <link href="https://fonts.cdnfonts.com/css/coolvetica-2" rel="stylesheet">
  <script>
    // Prevent browser auto-scroll restoration on refresh
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
    window.addEventListener('pageshow', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #ffffff;
      background-image: url('/images/star-tile.png');
      background-repeat: repeat;
      /* Fixed micro star tile */
      background-size: 37px 41px;
      background-position: top left;
      min-height: 200vh;
      position: relative;
      overflow-x: hidden;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 190px;
      /* Ultra-smooth multi-stop eased distribution */
      background: linear-gradient(
        to bottom,
        #96D7FF 0%,
        #96D7FF 20%,
        rgba(150, 215, 255, 0.99) 25%,
        rgba(150, 215, 255, 0.97) 30%,
        rgba(150, 215, 255, 0.94) 35%,
        rgba(150, 215, 255, 0.89) 41%,
        rgba(150, 215, 255, 0.82) 47%,
        rgba(150, 215, 255, 0.73) 54%,
        rgba(150, 215, 255, 0.63) 61%,
        rgba(150, 215, 255, 0.52) 68%,
        rgba(150, 215, 255, 0.40) 75%,
        rgba(150, 215, 255, 0.29) 82%,
        rgba(150, 215, 255, 0.18) 88%,
        rgba(150, 215, 255, 0.10) 93%,
        rgba(150, 215, 255, 0.03) 97%,
        rgba(150, 215, 255, 0) 100%
      );
      z-index: 1000;
      padding: 22px 72px 0 36px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 18px;
      text-decoration: none;
      pointer-events: auto;
    }

    .corner-logo {
      height: 75px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .nav-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 34px;
      font-weight: 400;
      color: #ffffff;
      line-height: 1;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 32px;
      margin-left: auto;
      padding-top: 22px;
      pointer-events: auto;
    }

    .nav-item {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 26px;
      font-weight: 400;
      color: #ffffff;
      text-decoration: none;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover {
      opacity: 0.82;
    }

    /* Left Star Graphic with 50% offset so it is half visible */
    @keyframes tiltStarOnLoad {
      from {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      to {
        transform: translate(-50%, -50%) rotate(17deg);
      }
    }

    .star-left {
      position: absolute;
      left: 0;
      top: 35vh;
      transform: translate(-50%, -50%) rotate(17deg);
      transform-origin: center center;
      animation: tiltStarOnLoad 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 10;
      pointer-events: none;
    }

    .star-left img {
      display: block;
      height: auto;
      max-height: 75vh;
    }

    /* Content Area */
    .content-area {
      min-height: 200vh;
      width: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 290px;
    }

    /* Container Wrapper to ensure proper z-index layering behind white box */
    .card-wrapper {
      width: 85%;
      max-width: 960px;
      position: relative;
      display: flex;
      justify-content: center;
    }

    /* Centered Rounded Rectangle */
    .center-rounded-rect {
      width: 100%;
      height: 580px;
      background-color: #ffffff;
      border-radius: 28px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.15), 0 0 6px rgba(0, 0, 0, 0.08);
      position: relative;
      z-index: 3;
      padding: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .group-photo-hero {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 16px;
      display: block;
    }

    @keyframes tiltStar2OnLoad {
      from {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      to {
        transform: translate(-50%, -50%) rotate(17deg);
      }
    }

    /* Star 2 Graphic (Layered behind the white box) */
    .star-2 {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translate(-50%, -50%) rotate(17deg);
      transform-origin: center center;
      animation: tiltStar2OnLoad 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 1;
      pointer-events: none;
    }

    .star-2 img {
      display: block;
      height: auto;
      max-height: 420px;
    }

    /* Hero Partial Face Graphic (Stuck to top of rectangle, in front of yellow rect, behind card) */
    .hero-partial-face {
      position: absolute;
      left: 40px;
      top: 0;
      transform: translateY(-60%);
      z-index: 2;
      pointer-events: none;
    }

    .hero-partial-face img {
      display: block;
      height: auto;
      max-height: 275px;
    }

    /* Hero Hand Holding Graphic (Fingers gripping the top edge of the white box) */
    .hero-hand-holding {
      position: absolute;
      left: 68px;
      top: 0;
      transform: translateY(-39%);
      z-index: 10;
      pointer-events: none;
    }

    .hero-hand-holding img {
      display: block;
      height: auto;
      max-height: 56px;
    }

    /* Yellow Rect Top Fade Accent (Positioned above the rectangle, tucked behind) */
    .yellow-rect-top-fade {
      position: absolute;
      top: 0;
      left: 260px;
      transform: translateY(-68%);
      pointer-events: none;
      z-index: 1;
    }

    .yellow-rect-top-fade img {
      display: block;
      width: auto;
      max-width: 722px;
      height: auto;
      max-height: 85px;
    }

    @keyframes fadeInFromAbove {
      from {
        opacity: 0;
        transform: translate(35%, -60%);
      }
      to {
        opacity: 1;
        transform: translate(35%, -50%);
      }
    }

    /* Star 3 Graphic (Stuck to right side of page, ~65% visible, fade in from above) */
    .star-3 {
      position: absolute;
      right: 0;
      top: 34vh;
      transform: translate(35%, -50%);
      animation: fadeInFromAbove 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 10;
      pointer-events: none;
    }

    .star-3 img {
      display: block;
      height: auto;
      max-height: 50vh;
    }

    @keyframes fadeInFromTopRight {
      from {
        opacity: 0;
        transform: translate(25px, -25px);
      }
      to {
        opacity: 1;
        transform: translate(0, 0);
      }
    }

    /* Star 4 Graphic Asset */
    .star-4 {
      position: absolute;
      right: 12vw;
      top: 44vh;
      animation: fadeInFromTopRight 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 10;
      pointer-events: none;
    }

    .star-4 img {
      display: block;
      height: auto;
      max-height: 120px;
    }

    <% if (typeof env !== 'undefined' && env === 'development') { %>
    /* Development Environment Centered Popup Modal (Flat Rectangle, No Borders, No Rounded Corners) */
    .dev-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10000;
      padding: 24px;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .dev-modal-overlay.dismissed {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }

    .dev-modal-card {
      background: #ffffff;
      border-radius: 0;
      border: none;
      padding: 44px 38px 36px 38px;
      max-width: 540px;
      width: 100%;
      box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.28);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      animation: modalPopIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .dev-modal-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #fef3c7;
      color: #92400e;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 0;
      border: none;
    }

    .dev-modal-indicator {
      width: 8px;
      height: 8px;
      background-color: #f59e0b;
      border-radius: 0;
      box-shadow: 0 0 8px #f59e0b;
    }

    .dev-modal-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 32px;
      font-weight: 400;
      color: #0f172a;
      line-height: 1.15;
      margin-top: 4px;
    }

    .dev-modal-text {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 15.5px;
      line-height: 1.6;
      color: #475569;
      margin-bottom: 8px;
      max-width: 440px;
    }

    .dev-modal-btn {
      background: #96D7FF;
      color: #0f172a;
      border: none;
      border-radius: 0;
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 22px;
      font-weight: 400;
      letter-spacing: 0.02em;
      padding: 12px 48px;
      cursor: pointer;
      min-width: 140px;
      box-shadow: 0 6px 20px rgba(150, 215, 255, 0.45);
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }

    .dev-modal-btn:hover {
      background-color: #7dcbfd;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(150, 215, 255, 0.6);
    }

    .dev-modal-btn:active {
      transform: translateY(0);
    }

    @keyframes modalPopIn {
      from {
        opacity: 0;
        transform: scale(0.92) translateY(12px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
    <% } %>
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">
        <img src="/images/corner-logo.png" alt="Logo" class="corner-logo">
      </a>
      <span class="nav-title">X ICP RPL 35’</span>
    </div>

    <ul class="nav-menu">
      <li><a href="/" class="nav-item">Home</a></li>
      <li><a href="#kita" class="nav-item">Kita!</a></li>
      <li><a href="#struktur" class="nav-item">Struktur</a></li>
      <li><a href="#kontak" class="nav-item">Kontak</a></li>
    </ul>
  </nav>

  <!-- Left Star Asset -->
  <div class="star-left">
    <img src="/images/star-1.svg" alt="Star Graphic">
  </div>

  <!-- Right Star Asset (Star 3) -->
  <div class="star-3">
    <img src="/images/star-3.svg" alt="Star 3 Graphic">
  </div>

  <!-- Star 4 Accent Graphic -->
  <div class="star-4">
    <img src="/images/star-4.svg" alt="Star 4 Graphic">
  </div>

  <!-- Scrollable Content Area -->
  <main class="content-area">
    <div class="card-wrapper">
      <!-- Star 2 Graphic Asset (Rendered behind the white box) -->
      <div class="star-2">
        <img src="/images/star-2.svg" alt="Star 2 Graphic">
      </div>
      <!-- Yellow Rect Top Fade Accent Graphic (Rendered behind the face) -->
      <div class="yellow-rect-top-fade">
        <img src="/images/yellow-rect-top-fade.svg" alt="Yellow Rect Top Fade">
      </div>
      <!-- Hero Partial Face Graphic Asset -->
      <div class="hero-partial-face">
        <img src="/images/hero-partial-face.svg" alt="Hero Face Graphic">
      </div>
      <!-- Horizontally Centered Rounded Rectangle (Rendered on top of Star 2) -->
      <div class="center-rounded-rect">
        <img src="/images/group-photo-hero.jpg" alt="Group Photo" class="group-photo-hero">
      </div>
      <!-- Hero Hand Holding Graphic Asset (Rendered on top of the card edge) -->
      <div class="hero-hand-holding">
        <img src="/images/hero-hand-holding.svg" alt="Hero Hands Graphic">
      </div>
    </div>
  </main>

  <!-- Development Environment Notice Modal (Sharp Corners, 5s Countdown Auto-Dismiss, 1-Hour Cookie Persistence) -->
  <% if (typeof env !== 'undefined' && env === 'development') { %>
    <div id="dev-modal-overlay" class="dev-modal-overlay">
      <div class="dev-modal-card" role="dialog" aria-modal="true" aria-labelledby="dev-modal-title">
        <div class="dev-modal-badge">
          <span class="dev-modal-indicator"></span>
          <span>Development Environment</span>
        </div>
        <h2 id="dev-modal-title" class="dev-modal-title">Notice</h2>
        <p class="dev-modal-text">
          You are accessing a <strong>development version</strong> of this website. Things are actively being built, and features might break or change without notice.
        </p>
        <button id="dev-modal-btn" class="dev-modal-btn" onclick="dismissDevModal()">OK (5)</button>
      </div>
    </div>

    <script>
      let devModalInterval = null;

      function setDevModalCookie() {
        // Persist for 1 hour (3600 seconds)
        document.cookie = "dev_modal_seen=1; max-age=3600; path=/; SameSite=Lax";
      }

      function hasDevModalCookie() {
        return document.cookie.split(';').some((item) => item.trim().startsWith('dev_modal_seen='));
      }

      function dismissDevModal() {
        setDevModalCookie();
        if (devModalInterval) {
          clearInterval(devModalInterval);
          devModalInterval = null;
        }
        const overlay = document.getElementById('dev-modal-overlay');
        if (overlay) {
          overlay.classList.add('dismissed');
          setTimeout(() => {
            overlay.remove();
          }, 350);
        }
      }

      // Check 1-hour persistence cookie
      (function initDevModal() {
        if (hasDevModalCookie()) {
          const overlay = document.getElementById('dev-modal-overlay');
          if (overlay) overlay.remove();
          return;
        }

        const overlay = document.getElementById('dev-modal-overlay');
        if (overlay) {
          overlay.style.display = 'flex';
          setDevModalCookie();
        }

        let secondsLeft = 5;
        const btn = document.getElementById('dev-modal-btn');
        if (btn) {
          btn.textContent = `OK (${secondsLeft})`;
        }

        devModalInterval = setInterval(() => {
          secondsLeft -= 1;
          if (secondsLeft > 0) {
            if (btn) btn.textContent = `OK (${secondsLeft})`;
          } else {
            clearInterval(devModalInterval);
            devModalInterval = null;
            dismissDevModal();
          }
        }, 1000);
      })();
    </script>
  <% } %>
</body>
</html>
