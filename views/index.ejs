<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Irena Website' %></title>
  <!-- Coolvetica Web Font -->
  <link href="https://fonts.cdnfonts.com/css/coolvetica-2" rel="stylesheet">
  <script>
    // Prevent browser auto-scroll restoration on refresh
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
    window.addEventListener('pageshow', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #ffffff;
      background-image: url('/images/star-tile.png');
      background-repeat: repeat;
      /* Fixed micro star tile */
      background-size: 37px 41px;
      background-position: top left;
      min-height: 200vh;
      position: relative;
      overflow-x: hidden;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 190px;
      /* Ultra-smooth multi-stop eased distribution */
      background: linear-gradient(
        to bottom,
        #96D7FF 0%,
        #96D7FF 20%,
        rgba(150, 215, 255, 0.99) 25%,
        rgba(150, 215, 255, 0.97) 30%,
        rgba(150, 215, 255, 0.94) 35%,
        rgba(150, 215, 255, 0.89) 41%,
        rgba(150, 215, 255, 0.82) 47%,
        rgba(150, 215, 255, 0.73) 54%,
        rgba(150, 215, 255, 0.63) 61%,
        rgba(150, 215, 255, 0.52) 68%,
        rgba(150, 215, 255, 0.40) 75%,
        rgba(150, 215, 255, 0.29) 82%,
        rgba(150, 215, 255, 0.18) 88%,
        rgba(150, 215, 255, 0.10) 93%,
        rgba(150, 215, 255, 0.03) 97%,
        rgba(150, 215, 255, 0) 100%
      );
      z-index: 1000;
      padding: 22px 48px 0 36px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 18px;
      text-decoration: none;
      pointer-events: auto;
    }

    .corner-logo {
      height: 75px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .nav-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 34px;
      font-weight: 400;
      color: #ffffff;
      line-height: 1;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 32px;
      margin-left: auto;
      padding-top: 22px;
      pointer-events: auto;
    }

    .nav-item {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 26px;
      font-weight: 400;
      color: #ffffff;
      text-decoration: none;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover {
      opacity: 0.82;
    }

    /* Left Star Graphic with 50% offset so it is half visible */
    @keyframes tiltStarOnLoad {
      from {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      to {
        transform: translate(-50%, -50%) rotate(38deg);
      }
    }

    .star-left {
      position: absolute;
      left: 0;
      top: 35vh;
      transform: translate(-50%, -50%) rotate(38deg);
      transform-origin: center center;
      animation: tiltStarOnLoad 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 10;
      pointer-events: none;
    }

    .star-left img {
      display: block;
      height: auto;
      max-height: 75vh;
    }

    /* Content Area */
    .content-area {
      min-height: 200vh;
      width: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 230px;
    }

    /* Centered Rounded Rectangle */
    .center-rounded-rect {
      width: 85%;
      max-width: 960px;
      height: 480px;
      background-color: #ffffff;
      border-radius: 28px;
      box-shadow: 0 12px 36px -6px rgba(0, 0, 0, 0.07), 0 4px 12px -2px rgba(0, 0, 0, 0.03);
      border: 1px solid rgba(226, 232, 240, 0.85);
      position: relative;
      z-index: 5;
    }

    <% if (typeof env !== 'undefined' && env === 'development') { %>
    /* Development Environment Centered Popup Modal (Flat Rectangle, No Borders, No Rounded Corners) */
    .dev-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
      padding: 24px;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .dev-modal-overlay.dismissed {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }

    .dev-modal-card {
      background: #ffffff;
      border-radius: 0;
      border: none;
      padding: 44px 38px 36px 38px;
      max-width: 540px;
      width: 100%;
      box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.28);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      animation: modalPopIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .dev-modal-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #fef3c7;
      color: #92400e;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 0;
      border: none;
    }

    .dev-modal-indicator {
      width: 8px;
      height: 8px;
      background-color: #f59e0b;
      border-radius: 0;
      box-shadow: 0 0 8px #f59e0b;
    }

    .dev-modal-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 32px;
      font-weight: 400;
      color: #0f172a;
      line-height: 1.15;
      margin-top: 4px;
    }

    .dev-modal-text {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 15.5px;
      line-height: 1.6;
      color: #475569;
      margin-bottom: 8px;
      max-width: 440px;
    }

    .dev-modal-btn {
      background: #96D7FF;
      color: #0f172a;
      border: none;
      border-radius: 0;
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 22px;
      font-weight: 400;
      letter-spacing: 0.02em;
      padding: 12px 48px;
      cursor: pointer;
      min-width: 140px;
      box-shadow: 0 6px 20px rgba(150, 215, 255, 0.45);
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }

    .dev-modal-btn:hover {
      background-color: #7dcbfd;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(150, 215, 255, 0.6);
    }

    .dev-modal-btn:active {
      transform: translateY(0);
    }

    @keyframes modalPopIn {
      from {
        opacity: 0;
        transform: scale(0.92) translateY(12px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
    <% } %>
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">
        <img src="/images/corner-logo.png" alt="Logo" class="corner-logo">
      </a>
      <span class="nav-title">X ICP RPL 35’</span>
    </div>

    <ul class="nav-menu">
      <li><a href="/" class="nav-item">Home</a></li>
      <li><a href="#kita" class="nav-item">Kita!</a></li>
      <li><a href="#struktur" class="nav-item">Struktur</a></li>
      <li><a href="#kontak" class="nav-item">Kontak</a></li>
    </ul>
  </nav>

  <!-- Left Star Asset -->
  <div class="star-left">
    <img src="/images/star-1.svg" alt="Star Graphic">
  </div>

  <!-- Scrollable Content Area -->
  <main class="content-area">
    <!-- Horizontally Centered Rounded Rectangle -->
    <div class="center-rounded-rect"></div>
  </main>

  <!-- Development Environment Notice Modal (Sharp Corners, 5s Countdown Auto-Dismiss) -->
  <% if (typeof env !== 'undefined' && env === 'development') { %>
    <div id="dev-modal-overlay" class="dev-modal-overlay">
      <div class="dev-modal-card" role="dialog" aria-modal="true" aria-labelledby="dev-modal-title">
        <div class="dev-modal-badge">
          <span class="dev-modal-indicator"></span>
          <span>Development Environment</span>
        </div>
        <h2 id="dev-modal-title" class="dev-modal-title">Notice</h2>
        <p class="dev-modal-text">
          You are accessing a <strong>development version</strong> of this website. Things are actively being built, and features might break or change without notice.
        </p>
        <button id="dev-modal-btn" class="dev-modal-btn" onclick="dismissDevModal()">OK (5)</button>
      </div>
    </div>

    <script>
      let devModalInterval = null;

      function dismissDevModal() {
        if (devModalInterval) {
          clearInterval(devModalInterval);
          devModalInterval = null;
        }
        const overlay = document.getElementById('dev-modal-overlay');
        if (overlay) {
          overlay.classList.add('dismissed');
          setTimeout(() => {
            overlay.remove();
          }, 350);
        }
      }

      // 5-second countdown timer on the OK button
      (function startDevCountdown() {
        let secondsLeft = 5;
        const btn = document.getElementById('dev-modal-btn');
        if (btn) {
          btn.textContent = `OK (${secondsLeft})`;
        }

        devModalInterval = setInterval(() => {
          secondsLeft -= 1;
          if (secondsLeft > 0) {
            if (btn) btn.textContent = `OK (${secondsLeft})`;
          } else {
            clearInterval(devModalInterval);
            devModalInterval = null;
            dismissDevModal();
          }
        }, 1000);
      })();
    </script>
  <% } %>
</body>
</html>
