<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Irena Website' %></title>
  <!-- Coolvetica Web Font -->
  <link href="https://fonts.cdnfonts.com/css/coolvetica-2" rel="stylesheet">
  <script>
    // Prevent browser auto-scroll restoration on refresh
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
    window.addEventListener('pageshow', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #ffffff;
      background-image: url('/images/star-tile.png');
      background-repeat: repeat;
      /* Fixed micro star tile */
      background-size: 37px 41px;
      background-position: top left;
      min-height: 200vh;
      position: relative;
      overflow-x: hidden;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 190px;
      /* Ultra-smooth multi-stop eased distribution */
      background: linear-gradient(
        to bottom,
        #96D7FF 0%,
        #96D7FF 20%,
        rgba(150, 215, 255, 0.99) 25%,
        rgba(150, 215, 255, 0.97) 30%,
        rgba(150, 215, 255, 0.94) 35%,
        rgba(150, 215, 255, 0.89) 41%,
        rgba(150, 215, 255, 0.82) 47%,
        rgba(150, 215, 255, 0.73) 54%,
        rgba(150, 215, 255, 0.63) 61%,
        rgba(150, 215, 255, 0.52) 68%,
        rgba(150, 215, 255, 0.40) 75%,
        rgba(150, 215, 255, 0.29) 82%,
        rgba(150, 215, 255, 0.18) 88%,
        rgba(150, 215, 255, 0.10) 93%,
        rgba(150, 215, 255, 0.03) 97%,
        rgba(150, 215, 255, 0) 100%
      );
      z-index: 1000;
      padding: 22px 48px 0 36px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 18px;
      text-decoration: none;
      pointer-events: auto;
    }

    .corner-logo {
      height: 75px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .nav-title {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 34px;
      font-weight: 400;
      color: #ffffff;
      line-height: 1;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 32px;
      margin-left: auto;
      padding-top: 22px;
      pointer-events: auto;
    }

    .nav-item {
      font-family: 'Coolvetica', 'Coolvetica Rg', 'Coolvetica Regular', sans-serif;
      font-size: 26px;
      font-weight: 400;
      color: #ffffff;
      text-decoration: none;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover {
      opacity: 0.82;
    }

    /* Left Star Graphic with 50% offset so it is half visible */
    @keyframes tiltStarOnLoad {
      from {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      to {
        transform: translate(-50%, -50%) rotate(38deg);
      }
    }

    .star-left {
      position: absolute;
      left: 0;
      top: 35vh;
      transform: translate(-50%, -50%) rotate(38deg);
      transform-origin: center center;
      animation: tiltStarOnLoad 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 10;
      pointer-events: none;
    }

    .star-left img {
      display: block;
      height: auto;
      max-height: 75vh;
    }

    /* Content Area */
    .content-area {
      min-height: 200vh;
      width: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 230px;
    }

    /* Centered Rounded Rectangle */
    .center-rounded-rect {
      width: 85%;
      max-width: 960px;
      height: 480px;
      background-color: #ffffff;
      border-radius: 28px;
      box-shadow: 0 12px 36px -6px rgba(0, 0, 0, 0.07), 0 4px 12px -2px rgba(0, 0, 0, 0.03);
      border: 1px solid rgba(226, 232, 240, 0.85);
      position: relative;
      z-index: 5;
    }

    /* Non-intrusive Development Mode Toast */
    .dev-toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #f8fafc;
      padding: 10px 16px;
      border-radius: 100px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2), 0 4px 10px -2px rgba(0, 0, 0, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.15);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 13.5px;
      font-weight: 500;
      animation: devToastFadeIn 0.4s ease forwards, devToastFadeOut 0.5s ease 5.5s forwards;
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
    }

    .dev-toast.hidden {
      opacity: 0 !important;
      transform: translateY(12px) !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }

    .dev-toast-content {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .dev-indicator {
      width: 8px;
      height: 8px;
      background-color: #f59e0b;
      border-radius: 50%;
      box-shadow: 0 0 8px #f59e0b;
    }

    .dev-toast-close {
      background: transparent;
      border: none;
      color: #94a3b8;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      padding: 0 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease;
    }

    .dev-toast-close:hover {
      color: #ffffff;
    }

    @keyframes devToastFadeIn {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes devToastFadeOut {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(12px);
        visibility: hidden;
        pointer-events: none;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">
        <img src="/images/corner-logo.png" alt="Logo" class="corner-logo">
      </a>
      <span class="nav-title">X ICP RPL 35’</span>
    </div>

    <ul class="nav-menu">
      <li><a href="/" class="nav-item">Home</a></li>
      <li><a href="#kita" class="nav-item">Kita!</a></li>
      <li><a href="#struktur" class="nav-item">Struktur</a></li>
      <li><a href="#kontak" class="nav-item">Kontak</a></li>
    </ul>
  </nav>

  <!-- Left Star Asset -->
  <div class="star-left">
    <img src="/images/star-1.svg" alt="Star Graphic">
  </div>

  <!-- Scrollable Content Area -->
  <main class="content-area">
    <!-- Horizontally Centered Rounded Rectangle -->
    <div class="center-rounded-rect"></div>
  </main>

  <!-- Development Version Temporary Popup -->
  <% if (typeof env !== 'undefined' && env === 'development') { %>
    <aside id="dev-toast" class="dev-toast">
      <div class="dev-toast-content">
        <span class="dev-indicator"></span>
        <span>You are accessing a development version</span>
      </div>
      <button class="dev-toast-close" onclick="document.getElementById('dev-toast').classList.add('hidden')" aria-label="Close">&times;</button>
    </aside>
  <% } %>
</body>
</html>
